# Names only. Put the values in your own shell. Do not paste tokens into chat
# and do not commit a filled-in copy of this file.

# Long-lived Page access token for the Facebook Page linked to the Instagram
# professional account. Instagram Graph API, content publishing.
IG_ACCESS_TOKEN=

# Instagram professional account id. Not the Facebook Page id.
IG_USER_ID=

# Optional. Graph version segment, default v22.0.
IG_GRAPH_VERSION=

# Optional. Public https folder where carousel JPEGs are hosted.
# Reels upload from disk and do not need this.
IG_MEDIA_PUBLIC_BASE_URL=

# Optional. Only if you run: python -m ig_pipeline generate --voice azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
